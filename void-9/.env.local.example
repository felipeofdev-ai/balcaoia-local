# Hotmart API
HOTMART_CLIENT_ID=seu_client_id
HOTMART_CLIENT_SECRET=seu_client_secret
HOTMART_ENV=production
HOTMART_API_BASE=https://api-sec-vlc.hotmart.com
HOTMART_PAYMENTS_API_BASE=https://developers.hotmart.com/payments/api/v1
HOTMART_PRODUCT_ID=
HOTMART_PRODUCT_IDS=

# Webhook (copie o token do painel Hotmart → Ferramentas → Webhook)
HOTMART_HOTTOK=seu_hottok_aqui
HOTTOK=seu_hottok_aqui
WEBHOOK_SECRET=gere_um_uuid_aqui
WEBHOOK_IP_BLACKLIST=

# Proteção das rotas /api/hotmart/*
APP_SECRET=gere_um_secret_forte_aqui
HOTMART_API_SECRET=

# App / checkout público
NEXT_PUBLIC_APP_URL=https://balcaoialocal.com.br
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=https://pay.hotmart.com/SEU_CHECKOUT
NEXT_PUBLIC_HOTMART_AFFILIATE_URL=
NEXT_PUBLIC_HOTMART_WEBHOOK_URL=https://balcaoialocal.com.br/api/webhooks/hotmart

# Database (opcional — Studio usa Supabase se configurado)
DATABASE_URL=
