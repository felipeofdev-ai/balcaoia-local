# =============================================================================
# BalcãoIA Studio — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha o que for usar.
# Nenhuma variável aqui é obrigatória: sem elas, o app roda em modo
# demo/mock (dados em localStorage/memória) para permitir avaliação local.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# URL pública do site (usada em metadados, sitemap e robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Sem estas 3 variáveis, o app usa localStorage no navegador e stores em
# memória no servidor (modo demo/MVP). Com elas, os dados persistem no
# Postgres do Supabase (aplique a migration em supabase/migrations/).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Hotmart
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=
NEXT_PUBLIC_HOTMART_AFFILIATE_URL=
NEXT_PUBLIC_HOTMART_PRODUCT_ID=
NEXT_PUBLIC_HOTMART_WEBHOOK_URL=https://balcaoia-studio.vercel.app/api/webhooks/hotmart
NEXT_PUBLIC_SALES_PAGE_URL=https://balcaoia-studio.vercel.app/vendas
NEXT_PUBLIC_MEMBERS_URL=https://balcaoia-studio.vercel.app/app/login
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID=

# Mídia / VSL / domínio oficial
NEXT_PUBLIC_VSL_VENDAS_URL=
NEXT_PUBLIC_VSL_AULA_URL=
NEXT_PUBLIC_DEMO_STUDIO_URL=
NEXT_PUBLIC_SITE_DOMAIN=balcaoialocal.com.br
NEXT_PUBLIC_SUPPORT_EMAIL=contato@balcaoialocal.com.br
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# AI Provider (mock | groq | openai | anthropic | gemini)
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# IA — Provedor de geração de texto
# AI_PROVIDER = mock | openai | anthropic | gemini
# "mock" (padrão) não requer nenhuma chave e gera conteúdo determinístico,
# ideal para desenvolvimento e testes.
# -----------------------------------------------------------------------------
AI_PROVIDER=mock

# OpenAI (usado quando AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (usado quando AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (usado quando AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Hotmart — Webhook de compra (ativação/suspensão de acesso)
# Configure a URL pública "<seu-dominio>/api/webhooks/hotmart" no painel da
# Hotmart e cole aqui o HOTTOK exibido lá para validar a autenticidade das
# chamadas. Sem HOTMART_HOTTOK definido, o webhook aceita qualquer chamada
# (modo permissivo, apenas para testes locais).
# -----------------------------------------------------------------------------
HOTMART_HOTTOK=

# -----------------------------------------------------------------------------
# Canais de atendimento — WhatsApp Cloud API (oficial)
# Por padrão, a integração oficial fica DESATIVADA no MVP. NUNCA defina como
# "true" sem também configurar as credenciais oficiais da Meta abaixo.
# Não há e nunca haverá suporte a bibliotecas não oficiais (OpenWA, Baileys,
# Venom, Evolution API, WA-Automate, scraping via QR Code) — ver README.
# -----------------------------------------------------------------------------
ENABLE_OFFICIAL_WHATSAPP_CLOUD=false
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# E-mail transacional (Resend)
# Sem RESEND_API_KEY, os e-mails são apenas logados no console (modo "log"),
# sem quebrar o fluxo de onboarding/compra.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="BalcãoIA Local <contato@balcaoialocal.com.br>"

# -----------------------------------------------------------------------------
# Analytics (opcional)
# O helper lib/analytics/track.ts sempre loga no console e, no browser,
# empurra eventos para window.dataLayer — compatível com GTM/GA4 se você
# adicionar o script correspondente no layout.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
